layout: base.njk
permalink: "contact.html"
title: "Contact Us | Earth Sanctuary Order of San Sau"
description: "Contact Earth Sanctuary Order of San Sau - Connect with Rev Dele"
---
    <main>
        <section class="site-section">
            <div class="container">
                <h1 class="section-title">Contact Us</h1>
                
                <div class="glass-card" style="max-width: 700px; margin: 0 auto 3rem;">
                    <h2>Get in Touch</h2>
                    <p style="font-size: 1.1rem;">
                        We welcome inquiries from those aligned with our values and ready to engage in spiritual growth and ecological stewardship.
                    </p>
                    
                    <div style="margin: 2rem 0; padding: 1.5rem; background: rgba(212, 175, 55, 0.1); border-radius: 12px;">
                        <h3>Contact Information</h3>
                        <p><strong>Email:</strong> <a href="mailto:orderofsansau9@gmail.com" style="color: var(--forest-green); font-weight: 600;">orderofsansau9@gmail.com</a></p>
                        <p><strong>Phone:</strong> <a href="tel:804-389-5150" style="color: var(--forest-green); font-weight: 600;">804-389-5150</a></p>
                        <p><strong>YouTube:</strong> <a href="https://youtube.com/@revdele" style="color: var(--forest-green); font-weight: 600;">@revdele</a> (Becoming EarthWise Podcasts)</p>
                        <p style="margin-top: 1rem; font-size: 0.95rem; opacity: 0.9;">
                            Feel free to call, text, or email. Please allow 24-48 hours for response.
                        </p>
                    </div>
                </div>

                <div class="glass-card" style="max-width: 700px; margin: 0 auto;">
                    <h2>Send Us a Message</h2>
                    <form action="https://formspree.io/f/xgveqjjy" method="POST" class="contact-form">
                        <div class="form-group">
                            <label for="name">Name *</label>
                            <input type="text" id="name" name="name" required>
                        </div>
                        
                        <div class="form-group">
                            <label for="email">Email *</label>
                            <input type="email" id="email" name="email" required>
                        </div>
                        
                        <div class="form-group">
                            <label for="phone">Phone</label>
                            <input type="tel" id="phone" name="phone">
                        </div>
                        
                        <div class="form-group">
                            <label for="interest">I'm interested in: *</label>
                            <select id="interest" name="interest" required>
                                <option value="">Select...</option>
                                <option value="meditation">Meditation Practice</option>
                                <option value="work-days">Community Work Days</option>
                                <option value="workshops">Workshops</option>
                                <option value="committed-series">Committed Series</option>
                                <option value="resilience-school">Resilience School</option>
                                <option value="land-visit">Visiting the Sacred Land</option>
                                <option value="general">General Inquiry</option>
                            </select>
                        </div>
                        
                        <div class="form-group">
                            <label for="message">Message *</label>
                            <textarea id="message" name="message" required placeholder="Tell us about yourself and your interest in the Order of San Sau..."></textarea>
                        </div>
                        
                        <div class="form-group">
                            <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                                <input type="checkbox" name="values-alignment" required>
                                <span>I have read the About page and align with the values of unconditional love, justice, and respect for women's leadership *</span>
                            </label>
                        </div>
                        
                        <button type="submit" class="btn btn-primary" style="width: 100%;">Send Message</button>
                        
                        <p style="margin-top: 1rem; font-size: 0.9rem; opacity: 0.8; text-align: center;">
                            * Required fields
                        </p>
                    </form>
                </div>
                
                <div class="glass-card" style="max-width: 700px; margin: 3rem auto 0; text-align: center;">
                    <h3>Location</h3>
                    <p style="font-size: 1.1rem;">
                        <strong>Unionville, Louisiana</strong><br>
                        On Delley ancestral land
                    </p>
                    <p style="margin-top: 1rem; font-size: 0.95rem;">
                        The land is open by invitation for spiritual and educational purposes. Please contact Rev Dele before visiting.
                    </p>
                </div>
            </div>
        </section>
    </main>
